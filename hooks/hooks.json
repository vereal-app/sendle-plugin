{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_sendle_)?sendle(-local)?__.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/validate.mjs\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/welcome.mjs\"" }
        ]
      }
    ]
  }
}
